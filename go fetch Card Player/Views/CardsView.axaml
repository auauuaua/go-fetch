<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CardPlayer.ViewModels"
             xmlns:models="using:CardPlayer.Models"
             xmlns:m="using:CardPlayer.Models"
             xmlns:v="using:CardPlayer.Views"
             x:Class="CardPlayer.Views.CardsView"
             x:DataType="vm:CardsViewModel">

  <Grid RowDefinitions="Auto,*">

    <!-- Accent separator bar -->
    <Border Grid.Row="0" Height="5" Background="{StaticResource AccentBrush}"/>

    <!-- Main content: preview panel left + tabs right -->
    <Grid Grid.Row="1" ColumnDefinitions="*">

      <!-- ── Full width: Sub-tabs + content + preview ───────────────────── -->
      <Grid Grid.Column="0" Grid.ColumnSpan="2">
        <TabControl Classes="subLevel" ItemsSource="{Binding TypeTabs}"
                    SelectedItem="{Binding SelectedTab}">

          <TabControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PlayerTypeTabViewModel">
              <TextBlock Text="{Binding TabHeader}" Classes="tabLabel"/>
            </DataTemplate>
          </TabControl.ItemTemplate>

        <TabControl.ContentTemplate>
          <DataTemplate x:DataType="vm:PlayerTypeTabViewModel">
            <Grid ColumnDefinitions="192,270,*" Margin="0,8,12,6">

              <!-- ── COL 0: Card previews stacked vertically, labels below ──────── -->
              <StackPanel Grid.Column="0" Spacing="4"
                          Margin="12,0,12,0" VerticalAlignment="Top">

                <Border HorizontalAlignment="Center" Width="166" Height="232"
                        CornerRadius="8"
                        BorderBrush="#44000000" BorderThickness="1">
                  <Border CornerRadius="8" ClipToBounds="True">
                    <Image Source="{Binding $parent[TabControl].((vm:CardsViewModel)DataContext).Preview.FrontBitmap}"
                           Stretch="Fill"/>
                  </Border>
                </Border>
                <TextBlock Text="FRONT" Classes="muted" FontSize="10"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>

                <Border HorizontalAlignment="Center" Width="166" Height="232"
                        CornerRadius="8"
                        BorderBrush="#44000000" BorderThickness="1">
                  <Border CornerRadius="8" ClipToBounds="True">
                    <Image Source="{Binding $parent[TabControl].((vm:CardsViewModel)DataContext).Preview.BackBitmap}"
                           Stretch="Fill"/>
                  </Border>
                </Border>
                <TextBlock Text="BACK" Classes="muted" FontSize="10"
                           HorizontalAlignment="Center" Margin="0,0,0,0"/>

                <!-- Go Fetch: simulate card insertion for selected entry -->
                <Button HorizontalAlignment="Center"
                        Margin="0,10,0,0"
                        Padding="12,8"
                        Background="{StaticResource AccentBrush}"
                        BorderThickness="0"
                        Command="{Binding $parent[TabControl].((vm:CardsViewModel)DataContext).GoFetchCommand}"
                        IsEnabled="{Binding Selected.QrCode, Converter={x:Static vm:StringNotEmptyConverter.Instance}}"
                        ToolTip.Tip="Simulate inserting this card — launches media exactly like a real card scan">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                    <Path Classes="icon-filled" Data="{StaticResource IconPlay}" Width="14" Height="14"/>
                    <TextBlock Text="go fetch" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>

              </StackPanel>

              <!-- ── COL 1: Scrollable — profile selector, title, text options ── -->
              <ScrollViewer Grid.Column="1"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            Margin="0,0,12,0">
                <StackPanel Spacing="6" VerticalAlignment="Top">

                  <!-- Card Layout Profile — editable ComboBox combines name + selector -->
                  <Border Background="{StaticResource BgElevatedBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1" CornerRadius="4"
                          Padding="8,8">
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto,Auto">
                      <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                 Text="LAYOUT PROFILE" Classes="muted" Margin="0,0,0,6"/>
                      <!-- IsEditable lets the user type a name directly in the box;
                           clicking the arrow drops the list; selecting from list loads it -->
                      <ComboBox Grid.Row="1" Grid.Column="0"
                                ItemsSource="{Binding $parent[TabControl].((vm:CardsViewModel)DataContext).LayoutProfiles.Profiles}"
                                SelectedItem="{Binding $parent[TabControl].((vm:CardsViewModel)DataContext).LayoutProfiles.SelectedProfile}"
                                HorizontalAlignment="Stretch" Margin="0,0,4,4">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <Button Grid.Row="1" Grid.Column="1"
                              Command="{Binding $parent[TabControl].((vm:CardsViewModel)DataContext).LayoutProfiles.AddProfileCommand}"
                              ToolTip.Tip="Save current settings as new profile"
                              Padding="6,4" Margin="0,0,4,4"><Path Classes="icon" Data="{StaticResource IconPlus}" Width="13" Height="13"/></Button>
                      <Button Grid.Row="1" Grid.Column="2"
                              Command="{Binding $parent[TabControl].((vm:CardsViewModel)DataContext).LayoutProfiles.DeleteProfileCommand}"
                              ToolTip.Tip="Delete selected profile"
                              IsEnabled="{Binding $parent[TabControl].((vm:CardsViewModel)DataContext).LayoutProfiles.Profiles.Count, Converter={x:Static vm:CountGreaterThanOneConverter.Instance}}"
                              Classes="danger"
                              Padding="6,4" Margin="0,0,0,4"><Path Classes="icon" Data="{StaticResource IconTrash}" Width="14" Height="14"/></Button>
                      <TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                               Text="{Binding $parent[TabControl].((vm:CardsViewModel)DataContext).LayoutProfiles.ProfileName}"
                               IsEnabled="{Binding $parent[TabControl].((vm:CardsViewModel)DataContext).LayoutProfiles.IsProfileNameEditable}"
                               Watermark="Select or add a profile…"/>
                    </Grid>
                  </Border>

                  <!-- Title -->
                  <TextBlock Text="TITLE" Classes="muted" FontSize="10"/>
                  <TextBox Text="{Binding Selected.DisplayText}"
                           IsEnabled="{Binding Selected, Converter={x:Static vm:NotNullConverter.Instance}}"
                           Watermark="Title…"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           MinHeight="32"
                           MaxHeight="80"/>

                  <!-- Text options expander -->
                  <Border Background="{StaticResource BgSurfaceBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1" CornerRadius="4"
                          Margin="0,4,0,0">
                    <Expander Header="Text Options" IsExpanded="False"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Padding="8,4">
                      <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,4"
                            DataContext="{Binding $parent[TabControl].((vm:CardsViewModel)DataContext)}">
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Side:"
                                   Classes="muted" VerticalAlignment="Center"
                                   Margin="0,0,8,4"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                    Orientation="Horizontal" Spacing="12"
                                    Margin="0,0,0,4">
                          <RadioButton Content="Front" IsChecked="{Binding TextOnFront}" FontSize="11"/>
                          <RadioButton Content="Back"  IsChecked="{Binding TextOnBack}"  FontSize="11"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Font:"
                                   Classes="muted" VerticalAlignment="Center"
                                   Margin="0,0,8,4"/>
                        <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                              ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                          <TextBox Grid.Column="0" Text="{Binding TextFont}"
                                   Watermark="e.g. Arial" Margin="0,0,6,0"/>
                          <Button  Grid.Column="1" Command="{Binding BrowseFontCommand}"
                                   ToolTip.Tip="Browse installed fonts"><TextBlock Text="Aa" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/></Button>
                        </Grid>

                        <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                Margin="0,0,0,4" IsVisible="{Binding ShowFontPicker}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="3"
                                Background="{StaticResource BgSurfaceBrush}">
                          <Grid RowDefinitions="Auto,*">
                            <TextBox Grid.Row="0" Text="{Binding FontSearch}"
                                     Watermark="Search fonts…" Margin="4"/>
                            <ListBox Grid.Row="1" ItemsSource="{Binding FilteredFonts}"
                                     SelectedItem="{Binding SelectedFontItem}" MaxHeight="160">
                              <ListBox.ItemTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding}" FontSize="12"/>
                                </DataTemplate>
                              </ListBox.ItemTemplate>
                            </ListBox>
                          </Grid>
                        </Border>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Style:"
                                   Classes="muted" VerticalAlignment="Center"
                                   Margin="0,0,8,4"/>
                        <ComboBox  Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                   Margin="0,0,0,4"
                                   ItemsSource="{Binding FontStyles}"
                                   SelectedItem="{Binding TextStyle}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Size:"
                                   Classes="muted" VerticalAlignment="Center"
                                   Margin="0,0,8,4"/>
                        <TextBox   Grid.Row="4" Grid.Column="1" Margin="0,0,0,4"
                                   Text="{Binding TextSize, Converter={x:Static vm:NullableIntConverter.Instance}}"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Color:"
                                   Classes="muted" VerticalAlignment="Center"
                                   Margin="0,0,8,4"/>
                        <v:ColorPickerBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
                                          Margin="0,0,0,4"
                                          Color="{Binding TextColor}"/>
                      </Grid>
                    </Expander>
                  </Border>

                  <!-- Art Options expander: Art Fit + Background colors -->
                  <Border Background="{StaticResource BgSurfaceBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1" CornerRadius="4"
                          Margin="0,4,0,0">
                    <Expander Header="Art Options" IsExpanded="False"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Padding="8,4">
                      <StackPanel Spacing="10" Margin="0,6,0,4"
                                  DataContext="{Binding $parent[TabControl].((vm:CardsViewModel)DataContext)}">

                        <!-- Art Fit — 4-way selector -->
                        <TextBlock Text="ART FIT" Classes="muted" FontSize="10"/>
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                          <RadioButton Grid.Row="0" Grid.Column="0"
                                       IsChecked="{Binding ArtFitIsFill}"
                                       GroupName="ArtFitGroup"
                                       Margin="0,0,4,4" FontSize="11"
                                       ToolTip.Tip="Scale to fill card, crop edges">Fill</RadioButton>
                          <RadioButton Grid.Row="0" Grid.Column="1"
                                       IsChecked="{Binding ArtFitIsFit}"
                                       GroupName="ArtFitGroup"
                                       Margin="0,0,0,4" FontSize="11"
                                       ToolTip.Tip="Scale to fit inside card, letterbox">Fit</RadioButton>
                          <RadioButton Grid.Row="1" Grid.Column="0"
                                       IsChecked="{Binding ArtFitIsSquareFill}"
                                       GroupName="ArtFitGroup"
                                       Margin="0,0,4,0" FontSize="11"
                                       ToolTip.Tip="Crop to square, fill the 2×2in area">Square Fill</RadioButton>
                          <RadioButton Grid.Row="1" Grid.Column="1"
                                       IsChecked="{Binding ArtFitIsSquareFit}"
                                       GroupName="ArtFitGroup"
                                       FontSize="11"
                                       ToolTip.Tip="Crop to square, fit inside the 2×2in area">Square Fit</RadioButton>
                        </Grid>

                        <!-- Background colors -->
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*">
                          <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                     Text="BACKGROUND" Classes="muted" FontSize="10" Margin="0,0,0,4"/>
                          <TextBlock Grid.Row="1" Grid.Column="0" Text="Front:"
                                     Classes="muted" VerticalAlignment="Center" Margin="0,0,8,4"/>
                          <v:ColorPickerBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,4"
                                            Color="{Binding FrontBgColor}"
                                            ToolTip.Tip="Hex color for front card background"/>
                          <TextBlock Grid.Row="2" Grid.Column="0" Text="Back:"
                                     Classes="muted" VerticalAlignment="Center" Margin="0,0,8,0"/>
                          <v:ColorPickerBox Grid.Row="2" Grid.Column="1"
                                            Color="{Binding BackBgColor}"
                                            ToolTip.Tip="Hex color for back card background"/>
                        </Grid>

                      </StackPanel>
                    </Expander>
                  </Border>

                </StackPanel>
              </ScrollViewer>

              <!-- ── COL 2: Scan expander + datagrid + action bar ──────────────── -->
              <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto">

              <!-- ── Scan / Import panel (hidden for Unassigned tab) ──────────── -->
              <Border Grid.Row="0" IsVisible="{Binding !IsUnassigned}"
                      Background="{StaticResource BgSurfaceBrush}"
                      BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1" CornerRadius="4"
                      Margin="0,0,0,8">
                <Expander IsExpanded="False" Padding="12,8"
                          HorizontalAlignment="Stretch"
                          ClipToBounds="False">
                  <Expander.Header>
                    <Button Command="{Binding ScanVm.RunScanCommand}"
                            Classes="accent" Padding="10,8" FontSize="12"
                            ClipToBounds="False"
                            ToolTip.Tip="Scan for media and art"
                            PointerPressed="ScanButton_PointerPressed">
                      <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Classes="icon" Data="{StaticResource IconSearch}"/>
                        <TextBlock Text="Scan" FontSize="12" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                  </Expander.Header>
                  <StackPanel Spacing="8" Margin="0,8,0,0">

                  <!-- Row 1: Scan Media -->
                  <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SCAN MEDIA:" Classes="muted" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding ScanVm.ScanPath}" Watermark="Folder to scan…"
                             Width="200" Margin="0,0,6,0"/>
                    <Button Command="{Binding ScanVm.BrowseScanPathCommand}" Padding="8,4" Margin="0,0,10,0"><Path Classes="icon" Data="{StaticResource IconFolder}" Width="15" Height="15"/></Button>
                    <ComboBox ItemsSource="{Binding ScanVm.ScanModes}" SelectedItem="{Binding ScanVm.ScanMode}"
                              Width="90" Margin="0,0,8,0"/>
                    <StackPanel Orientation="Horizontal" IsVisible="{Binding ScanVm.IsFoldersMode}" Spacing="6">
                      <TextBlock Text="Exclude folders:" Classes="muted" VerticalAlignment="Center"/>
                      <TextBox Text="{Binding ScanVm.ExcludeFolders}" Width="160"
                               Watermark="folder1, folder2…"
                               ToolTip.Tip="Comma-separated folder names to exclude from scan"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" IsVisible="{Binding !ScanVm.IsFoldersMode}" Spacing="6">
                      <TextBlock Text="File extensions:" Classes="muted" VerticalAlignment="Center"/>
                      <TextBox Text="{Binding ScanVm.FileExtensions}" Width="160"
                               Watermark=".mkv, .mp4… (blank = all)"
                               ToolTip.Tip="Comma-separated extensions to include (blank = all)"/>
                    </StackPanel>
                    <TextBlock Text="Depth:" Classes="muted" VerticalAlignment="Center" Margin="8,0,6,0"/>
                    <TextBox Text="{Binding ScanVm.Depth}" Width="36" Margin="0,0,10,0"
                             ToolTip.Tip="0 = direct children, 1 = one level deeper, etc."/>
                    <TextBlock Text="Title inverse depth:" Classes="muted" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding ScanVm.InverseDepth}" Width="36"
                             ToolTip.Tip="0 = name only, 1 = parent - name, …"/>
                  </WrapPanel>

                  <!-- Row 2: Scan Art -->
                  <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SCAN ART:" Classes="muted" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding ScanVm.ArtDirOverride}" Watermark="Same dir as media…"
                             Width="200" Margin="0,0,6,0"/>
                    <Button Command="{Binding ScanVm.BrowseArtDirOverrideCommand}" Padding="8,4" Margin="0,0,10,0"><Path Classes="icon" Data="{StaticResource IconFolder}" Width="15" Height="15"/></Button>
                    <TextBlock Text="Pattern:" Classes="muted" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding ScanVm.ArtPattern}" Width="100" Margin="0,0,8,0"
                             Watermark="cover, art…"
                             ToolTip.Tip="first, last, display, qr, a filename (e.g. cover), or blank = largest image file"/>
                    <TextBlock Text="Default profile:" Classes="muted" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding ScanVm.LayoutProfiles.Profiles}"
                              SelectedItem="{Binding ScanVm.DefaultProfile}"
                              Width="150" Margin="0,0,4,0">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Padding="5,4" Margin="0,0,10,0"
                            ToolTip.Tip="Clear default profile"
                            IsVisible="{Binding ScanVm.DefaultProfile, Converter={x:Static vm:NotNullConverter.Instance}}"
                            Command="{Binding ScanVm.ClearDefaultProfileCommand}"><Path Classes="icon" Data="{StaticResource IconClose}" Width="14" Height="14"/></Button>
                  </WrapPanel>

                  <!-- Row 4: Import CSV -->
                  <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="IMPORT CSV:" Classes="muted" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Command="{Binding ScanVm.ImportCsvCommand}" Padding="10,4" Margin="0,0,10,0"><StackPanel Orientation="Horizontal" Spacing="6"><Path Classes="icon" Data="{StaticResource IconFolder}" Width="15" Height="15"/><TextBlock Text="Browse &amp; Import" VerticalAlignment="Center"/></StackPanel></Button>
                  </WrapPanel>

                </StackPanel>
                </Expander>
              </Border>

              <!-- ── Assign panel (Unassigned tab only) ──────────────────────── -->
              <Border Grid.Row="0" IsVisible="{Binding IsUnassigned}"
                      Background="{StaticResource BgSurfaceBrush}"
                      BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1" CornerRadius="4"
                      Padding="12,10" Margin="0,0,0,8">
                <StackPanel Spacing="8">
                  <TextBlock Text="Select rows then choose a media type and click Assign to reassign them."
                             Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox ItemsSource="{Binding $parent[TabControl].((vm:CardsViewModel)DataContext).AvailableTypeTabs}"
                              SelectedItem="{Binding $parent[TabControl].((vm:CardsViewModel)DataContext).SelectedAssignTab}"
                              Width="220">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding TabHeader}"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Command="{Binding $parent[TabControl].((vm:CardsViewModel)DataContext).AssignSelectedCommand}"
                            Classes="accent" Padding="10,4">
                      Assign →
                    </Button>
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- ── Data grid ─────────────────────────────────────────────── -->
              <DataGrid Grid.Row="1"
                        SelectionChanged="OnSelectionChanged"
                        CellEditEnded="OnCellEditEnded"
                        Sorting="OnSorting"
                        PointerPressed="OnDataGridPointerPressed"
                        DragDrop.AllowDrop="True"
                        DragDrop.DragOver="OnGridDragOver"
                        DragDrop.Drop="OnGridDrop"
                        ItemsSource="{Binding SortedEntries}"
                        SelectedItem="{Binding Selected, Converter={x:Static vm:SuppressNullConverter.Instance}}"
                        SelectionMode="Extended"
                        AutoGenerateColumns="False"
                        CanUserResizeColumns="True"
                        CanUserSortColumns="True"
                        IsReadOnly="False">
                <!-- Local styles override Fluent theme's unfocused selection dimming -->
                <DataGrid.Styles>
                  <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
                    <Setter Property="Fill" Value="{StaticResource DirtyBrush}"/>
                    <Setter Property="Opacity" Value="0.2"/>
                    <Setter Property="IsVisible" Value="True"/>
                  </Style>
                  <Style Selector="DataGridRow:selected Rectangle#BackgroundRectangle">
                    <Setter Property="Fill" Value="{StaticResource DirtyBrush}"/>
                    <Setter Property="Opacity" Value="0.2"/>
                    <Setter Property="IsVisible" Value="True"/>
                  </Style>
                </DataGrid.Styles>
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="QR CODE" Width="275" SortMemberPath="QrCode">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="models:MediaEntry">
                        <TextBlock Text="{Binding QrCode}" Padding="12,0" VerticalAlignment="Center"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                      <DataTemplate x:DataType="models:MediaEntry">
                        <TextBox Text="{Binding QrCode}"
                                 MaxLength="32"
                                 BorderThickness="0"
                                 Padding="12,0"
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="PATH"
                                      Binding="{Binding Path}"
                                      Width="220" IsReadOnly="False"/>
                  <DataGridTextColumn Header="ART PATH"
                                      Binding="{Binding ArtPath}"
                                      Width="200" IsReadOnly="False"/>
                  <DataGridTextColumn Header="ART BACK PATH"
                                      Binding="{Binding ArtBackPath}"
                                      Width="200" IsReadOnly="False"/>
                  <DataGridTemplateColumn Header="STATUS" Width="180" IsReadOnly="True"
                                          SortMemberPath="ComputedStatus">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="models:MediaEntry">
                        <Border Background="{Binding StatusColor}" Padding="8,0">
                          <TextBlock Text="{Binding ComputedStatus}"
                                     VerticalAlignment="Center" FontSize="11"/>
                        </Border>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>

              <!-- ── Action bar ─────────────────────────────────────────────── -->
              <StackPanel Grid.Row="2" Spacing="6" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="ROW:" Classes="muted" VerticalAlignment="Center"/>
                  <Button Command="{Binding AddRowCommand}"           FontSize="11" Padding="8,4"><StackPanel Orientation="Horizontal" Spacing="6"><Path Classes="icon" Data="{StaticResource IconPlus}" Width="13" Height="13"/><TextBlock Text="Add" VerticalAlignment="Center"/></StackPanel></Button>
                  <Button Command="{Binding UnassignSelectedCommand}" FontSize="11" Padding="8,4"
                          IsVisible="{Binding !IsUnassigned}">Unassign</Button>
                  <Button Command="{Binding DeleteRowCommand}"        FontSize="11" Padding="8,4" Classes="danger"><StackPanel Orientation="Horizontal" Spacing="6"><Path Classes="icon" Data="{StaticResource IconTrash}" Width="14" Height="14"/><TextBlock Text="Delete" VerticalAlignment="Center"/></StackPanel></Button>
                  <Border Width="1" Background="{StaticResource BorderBrush}" Margin="4,0"/>
                  <TextBlock Text="STATE:" Classes="muted" VerticalAlignment="Center"/>
                  <Button Command="{Binding SetNewCommand}"  FontSize="11" Padding="8,4">Set New</Button>
                  <Button Command="{Binding SetSkipCommand}" FontSize="11" Padding="8,4">Set Skip</Button>
                </StackPanel>
              </StackPanel>

              </Grid><!-- end right column grid -->

            </Grid><!-- end DataTemplate root grid -->
          </DataTemplate>
        </TabControl.ContentTemplate>

      </TabControl>
      </Grid>

    </Grid>



  </Grid>
</UserControl>
