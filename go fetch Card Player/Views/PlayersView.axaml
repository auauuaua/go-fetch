<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CardPlayer.ViewModels"
             xmlns:v="using:CardPlayer.Views"
             x:Class="CardPlayer.Views.PlayersView"
             x:DataType="vm:PlayersViewModel">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- White separator bar between top-level and sub-level tabs -->
    <Border Grid.Row="0" Height="5" Background="{StaticResource AccentBrush}"/>

    <!-- Sub-tabs: one per player type -->
    <Grid Grid.Row="1">
      <TabControl Classes="subLevel" ItemsSource="{Binding Types}"
                  SelectedItem="{Binding SelectedType}">

      <TabControl.ItemTemplate>
        <DataTemplate x:DataType="vm:PlayerTypeViewModel">
          <TextBlock Text="{Binding TabHeader}" Classes="tabLabel"/>
        </DataTemplate>
      </TabControl.ItemTemplate>

      <TabControl.ContentTemplate>
        <DataTemplate x:DataType="vm:PlayerTypeViewModel">
          <v:PlayerTypeView DataContext="{Binding}"/>
        </DataTemplate>
      </TabControl.ContentTemplate>

    </TabControl>
    </Grid>
    <!-- Bottom action bar -->
    <Border Grid.Row="2" Classes="toolbar-top">
      <DockPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="PLAYER:" Classes="muted" VerticalAlignment="Center"/>
          <Button Command="{Binding MoveTypeLeftCommand}"  Padding="8,4" FontSize="11" ToolTip.Tip="Move player tab left"><Path Classes="icon" Data="{StaticResource IconChevronLeft}" Width="13" Height="13"/></Button>
          <Button Command="{Binding MoveTypeRightCommand}" Padding="8,4" FontSize="11" ToolTip.Tip="Move player tab right"><Path Classes="icon" Data="{StaticResource IconChevronRight}" Width="13" Height="13"/></Button>
          <Button Command="{Binding AddTypeCommand}"       Padding="8,4" FontSize="11"><StackPanel Orientation="Horizontal" Spacing="6"><Path Classes="icon" Data="{StaticResource IconPlus}" Width="13" Height="13"/><TextBlock Text="Add" VerticalAlignment="Center"/></StackPanel></Button>
          <Button Command="{Binding DuplicateTypeCommand}" Padding="8,4" FontSize="11"><StackPanel Orientation="Horizontal" Spacing="6"><Path Classes="icon" Data="{StaticResource IconDuplicate}" Width="13" Height="13"/><TextBlock Text="Duplicate" VerticalAlignment="Center"/></StackPanel></Button>
          <Button Command="{Binding DeleteTypeCommand}"    Padding="8,4" FontSize="11" Classes="danger"><StackPanel Orientation="Horizontal" Spacing="6"><Path Classes="icon" Data="{StaticResource IconTrash}" Width="14" Height="14"/><TextBlock Text="Delete" VerticalAlignment="Center"/></StackPanel></Button>
          
        </StackPanel>
      </DockPanel>
    </Border>

  </Grid>
</UserControl>
